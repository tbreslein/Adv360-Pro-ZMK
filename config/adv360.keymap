#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

&lt { quick-tap-ms = <170>; };

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
&kp ESC    &kp EXCL    &kp AT      &kp HASH      &kp DLLR     &kp PRCNT  &none /*                                */ &none  &kp CARET  &kp AMPS     &kp STAR     &kp LPAR    &kp RPAR       &kp EQUAL
&kp PIPE   &kp Q       &kp W       &kp E         &kp R        &kp T      &none /*                                */ &none  &kp Y      &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp DQT    &hm LGUI A  &hm LALT S  &hm LSHIFT D  &hm LCTRL F  &kp G      &none  &kp GRAVE  &none /**/ &none  &none  &none  &kp H      &hm RCTRL J  &hm RSHFT K  &hm LALT L  &hm RGUI SEMI  &kp SQT
&kp UNDER  &kp Z       &kp X       &kp C         &kp V        &kp B                      &kp TAB /**/ &none                &kp N      &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp MINUS
&none      &none       &none       &none         &none           &kp SPACE  &kp BSPC  &lt 1 LBKT /**/ &lt 1 RBKT  &kp DEL  &kp RET    &none        &none        &none       &none          &none
            >;
        };

        keypad {
            display-name = "keypad";
            bindings = <
&trans       &kp F1  &kp F2   &kp F3   &kp F4   &trans      &trans /*                              */ &none  &trans        &trans        &trans        &trans       &trans    &trans
&trans       &kp F5  &kp F6   &kp F7   &kp F8   &kp C_NEXT  &trans /*                              */ &none  &kp C_VOL_UP  &kp N7        &kp N8        &kp N9       &trans    &trans
&trans       &kp F9  &kp F10  &kp F11  &kp F12  &kp C_PP    &trans  &trans  &trans /**/ &none  &none  &none  &kp C_MUTE    &hm RCTRL N4  &hm RSHFT N5  &hm LALT N6  &kp RGUI  &trans
&trans       &trans  &trans   &trans   &trans   &trans                      &trans /**/ &none                &kp C_VOL_DN  &kp N1        &kp N2        &kp N3       &trans    &tog 2
&bootloader  &trans  &trans   &trans   &trans             &trans  &kp CAPS  &trans /**/ &trans  &caps_word  &kp N0         &trans        &trans        &trans       &trans    &bootloader
            >;
        };

        gaming {
            display-name = "gaming";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none /*                                */ &none  &kp N6  &kp N7       &kp N8       &kp N9      &kp N0         &kp EQUAL
&kp LALT   &kp Q   &kp W   &kp E   &kp R   &kp T   &none /*                                */ &none  &kp Y   &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp LCTRL  &kp A   &kp S   &kp D   &kp F   &kp G   &none  &kp GRAVE  &none /**/ &none  &none  &none  &kp H   &hm RCTRL J  &hm RSHFT K  &hm LALT L  &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V   &kp B                   &kp TAB /**/ &none                &kp N   &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp MINUS
&none      &none   &none   &none   &none     &kp SPACE  &kp BSPC  &kp LBKT /**/ &kp RBKT  &kp DEL  &kp RET   &none        &none        &none       &none          &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};

